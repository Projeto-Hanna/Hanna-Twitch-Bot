# Bloqueia a execução automática de scripts de ciclo de vida (ex: postinstall).
# Impede que pacotes maliciosos executem códigos arbitrários no seu ambiente.
# Se um pacote legítimo (ex: esbuild) precisar rodar scripts de compilação,
# você pode usar: npm install <pacote> --ignore-scripts=false
ignore-scripts=true

# Minimum Release Age (Disponível a partir do npm v11.10.0 - Fev/2026).
# Exige que o pacote tenha sido publicado há pelo menos 7 dias (cooldown).
# Muito eficaz contra ataques de Supply Chain recentes.
min-release-age=7

# Fixa a versão exata dos pacotes no package.json (remove ^ ou ~).
# Evita a instalação acidental de minor/patches comprometidos de forma silenciosa.
save-exact=true

# Garante que pacotes só sejam baixados via conexões seguras.
strict-ssl=true

# Força o npm a respeitar as versões de Node especificadas no "engines".
# Minimiza comportamentos inesperados do ambiente.
engine-strict=true

# Reduz poluição visual no terminal, ajudando a não ignorar alertas críticos.
fund=false
